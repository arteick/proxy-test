extends SceneTree
const Ascii = preload("res://scripts/ascii.gd")
const Move = preload("res://scripts/move.gd")
const Game = preload("res://scripts/game.gd")
const Hero = preload("res://scripts/hero.gd")
const Hud = preload("res://scripts/hud.gd")
const Level = preload("res://scripts/level.gd")
const Actors = preload("res://scripts/actors.gd")
const Fireball = preload("res://scripts/fireball.gd")
const Trail = preload("res://scripts/trail.gd")
const Explosion = preload("res://scripts/explosion.gd")
# Запуск: godot --headless --path godot -s tests/run.gd

var fails := 0

func check(ok: bool, name: String) -> void:
	print(("ok   " if ok else "FAIL ") + name)
	if not ok: fails += 1

func _init() -> void:
	check(Ascii.glyph_index(0.0) == 0, "яркость 0 -> пробел")
	check(Ascii.glyph_index(1.0) == Ascii.RAMP.length() - 1, "яркость 1 -> самый плотный")
	check(Ascii.glyph_index(-5.0) == 0 and Ascii.glyph_index(7.0) == Ascii.RAMP.length() - 1, "клэмп")
	check(Ascii.glyph_index(0.5) > Ascii.glyph_index(0.2), "монотонность")
	check(Ascii.cell_fade(1, 5, 20) == 0.0 and Ascii.cell_fade(50, 5, 20) == 1.0, "затухание: края")
	check(Ascii.cell_fade(12, 5, 20) > Ascii.cell_fade(8, 5, 20), "затухание растёт с расстоянием")
	check(Move.wish_dir(Vector2.ZERO, 0.0) == Vector3.ZERO, "движение: нет ввода")
	check(Move.wish_dir(Vector2(0, 1), 0.0).is_equal_approx(Vector3(0, 0, -1)), "движение: W идёт вперёд (-Z)")
	check(Move.wish_dir(Vector2(1, 1), 0.0).length() > 0.99 and Move.wish_dir(Vector2(1, 1), 0.0).length() < 1.01, "движение: диагональ нормализована")
	var wall := [Vector3(0, 0, 1.0)]
	var p := Move.step(Vector3(0, 0, 3), Vector3(0, 0, -1), 2.0, 1.0, 0.5, wall)
	check(p.z >= 1.5 - 0.001, "коллизия: не заходит в колонну")
	check(Move.step(Vector3(5, 0, 5), Vector3(1, 0, 0), 2.0, 0.5, 0.5, wall).x == 6.0, "движение без препятствий")
	var tc := Move.top_down_cam(Vector3.ZERO, 0.0, 1.0)
	check(tc.y > 25.0 and tc.z > 5.0 and tc.z < 15.0, "камера: вид почти строго сверху, не над героем")
	check(Move.ortho_size(2.0) > Move.ortho_size(1.0) and Move.ortho_size(99.0) == Move.ORTHO_SIZE * Move.ZOOM_MAX, "камера: масштаб растёт и ограничен")
	check(Move.marker_scale(1.0) == 1.0 and Move.marker_scale(Move.ZOOM_MAX) > 2.5, "значки: на дальнем масштабе крупнее")
	check(Move.far_blend(1.0) == 0.0 and Move.far_blend(Move.ZOOM_MAX) == 1.0, "дальний вид: плоские цвета только вдали")
	check(Move.ZOOM_FIXED >= Move.ZOOM_MIN and Move.ZOOM_FIXED <= 1.4, "камера: фиксированный масштаб близкий")
	check(Ascii.RAMP.length() >= 60, "шкала: не меньше 60 символов")
	var uniq := {}
	for ch in Ascii.RAMP: uniq[ch] = true
	check(uniq.size() == Ascii.RAMP.length(), "шкала: символы не повторяются")
	var lk := Move.look(0.0, 0.5, Vector2(100, 0), 0.01)
	check(is_equal_approx(lk.x, -1.0) and is_equal_approx(lk.y, 0.5), "камера: мышь вправо поворачивает yaw")
	check(is_equal_approx(Move.look(0.0, 0.5, Vector2(0, 1000), 0.01).y, Move.PITCH_MAX) and is_equal_approx(Move.look(0.0, 0.5, Vector2(0, -1000), 0.01).y, Move.PITCH_MIN), "камера: наклон ограничен")
	var g := Game.new(7)
	check(g.crystals.size() == Game.CRYSTALS and g.enemies.size() == Game.ENEMIES, "игра: старт, кристаллы и тени")
	check(Game.new(7).crystals == g.crystals and Game.new(8).crystals != g.crystals, "игра: seed детерминирован")
	var c0: Vector2 = g.crystals[0]
	g.enemies = [Vector2(500, 500)]
	g.homes = g.enemies.duplicate()
	var ev := g.update(Vector3(c0.x, 0, c0.y), 0.016)
	check(ev.has("pick") and g.score == 1 and g.crystals.size() == Game.CRYSTALS - 1, "игра: подбор кристалла")
	g.enemies = [Vector2(0, 0)]
	g.homes = g.enemies.duplicate()
	var far_hero := Vector3(0, 0, 8)
	g.update(far_hero, 1.0)
	check(g.enemies[0].y > 2.0 and g.enemies[0].y < 4.0, "игра: тень идёт к герою со своей скоростью")
	g.enemies = [Vector2(0, 8)]
	check(g.update(far_hero, 0.016).has("hurt") and g.hp == Game.HP_MAX - 1, "игра: касание тени отнимает жизнь")
	g.update(far_hero, 0.016)
	check(g.hp == Game.HP_MAX - 1, "игра: неуязвимость после удара")
	g.hp = 1; g.hurt_cd = 0.0
	check(g.update(far_hero, 0.016).has("lose") and g.state == "lose", "игра: поражение")
	check(g.update(far_hero, 1.0).is_empty(), "игра: после конца события не идут")
	var bg := Game.new(5)
	check(Game.HP_MAX > 3 and bg.enemy_hp == [Game.ENEMY_HP, Game.ENEMY_HP, Game.ENEMY_HP], "жизни: герой крепче, у всех мышей поровну")
	bg.enemies = [Vector2(0, 0), Vector2(1, 0), Vector2(50, 0)]
	bg.homes = bg.enemies.duplicate()
	bg.enemy_hp = [1, 3, 3]
	check(bg.blast(Vector2(0, 0), 1) == [0] and bg.enemies.size() == 2 and bg.enemy_hp == [2, 3] and bg.homes.size() == 2, "взрыв: ранит в радиусе, убивает без жизней, дальние целы")
	check(bg.kills == 1 and bg.blast(Vector2(1, 0)) == [0] and bg.kills == 2 and bg.enemies == [Vector2(50, 0)] and bg.blast(Vector2(50, 0)) == [0] and bg.enemies.is_empty(), "шар убивает мышь с одного попадания, убийства считаются")
	var w := Game.new(3)
	w.enemies = []; w.homes = []
	var evs: Array = []
	for c in w.crystals.duplicate():
		evs = w.update(Vector3(c.x, 0, c.y), 0.016)
	check(w.state == "win" and evs.has("win"), "игра: победа после последнего кристалла")
	var hero := Hero.new()
	hero._ready()
	check(hero.cape_segs.size() == Hero.CAPE_SEGS and hero.get_child_count() > 2, "герой: модель собирается")
	hero.animate(0.1, true, 0.1)
	check(hero.amp > 0.0 and hero.staff.rotation.x != 0.0, "герой: анимация ходьбы двигает суставы")
	hero.animate(0.1, false, 0.1)
	var hand: Vector3 = hero.body.transform * hero.arm_r.transform * Vector3(0, -0.85, 0)
	check(hand.z < -0.3, "герой: правая рука вынесена вперёд к посоху, не назад")
	var gh := Game.new(1)
	var txt := Hud.text(gh, Vector3.ZERO)
	check(txt.contains("Кристаллы 0/8") and txt.contains("♥♥♥♥♥") and txt.contains("Ближайший"), "HUD: счёт, жизни, подсказка")
	gh.state = "win"
	check(Hud.text(gh, Vector3.ZERO).contains("Победа"), "HUD: победа")
	gh.state = "lose"; gh.hp = 0
	check(Hud.text(gh, Vector3.ZERO).contains("Тени взяли") and Hud.text(gh, Vector3.ZERO).contains("···"), "HUD: поражение, жизни не уходят в минус")
	var root := Node3D.new()
	var fi := Level.floor_image()
	check(fi.get_width() == Level.TILE * 8 and fi.get_pixel(5, 5) != fi.get_pixel(40, 40), "пол: текстура с вариацией")
	check(Level.build(root).size() == Level.COLUMNS and root.get_child_count() == Level.COLUMNS + 1, "уровень: колонны и коллайдеры")
	var ruins_root := Node3D.new()
	var rc := Level.build_ruins(ruins_root)
	check(rc.size() == 10 and ruins_root.get_child_count() == 10, "руины: коллайдеры и детали")
	ruins_root.free()
	check(Actors.spawn_crystals(root, Game.new(2).crystals).size() == Game.CRYSTALS and Actors.spawn_enemies(root, Game.new(2).enemies).size() == Game.ENEMIES, "узлы: кристаллы и тени")
	var bat := Actors.make_bat(root, Vector3.ZERO)
	Actors.animate_bat(bat, 0.1, true)
	check(bat.get_meta("wing_l").rotation.z == -bat.get_meta("wing_r").rotation.z and bat.get_meta("wing_r").rotation.z != 0.0, "мышь: крылья машут симметрично")
	var amp_move := 0.0
	var amp_idle := 0.0
	for k in 100:
		amp_move = maxf(amp_move, absf(Actors.flap_angle(k * 0.01, true)))
		amp_idle = maxf(amp_idle, absf(Actors.flap_angle(k * 0.01, false)))
	check(amp_move > 0.3 and amp_idle > 0.1 and Actors.WING_FLAP_MOVE > Actors.WING_FLAP_IDLE, "мышь: крылья шевелятся и в движении, и на месте (в движении быстрее)")
	var fb := Fireball.new()
	fb.update(1.0, true, false)
	check(fb.state == "charging" and absf(fb.charge - 0.5) < 0.001 and Fireball.speed_mult(fb) < 1.0, "шар: растёт при удержании ЛКМ, герой замедлен")
	var r1 := fb.radius()
	fb.update(5.0, true, false)
	check(fb.charge == 1.0 and fb.radius() > r1, "шар: заряд ограничен 1, радиус растёт")
	var tgt := Fireball.aim_target(Vector3.ZERO, Vector3(0, 0, -30))
	check(absf(tgt.z + Fireball.MAX_RANGE) < 0.001 and tgt.y == 0.0, "цель шара: курсор далеко -> граница дальности")
	check(Fireball.aim_target(Vector3(1, 0, 1), Vector3(4, 0, 1)).is_equal_approx(Vector3(4, 0, 1)), "цель шара: курсор близко -> ровно в курсор")
	check(Fireball.aim_target(Vector3(2, 0, 2), Vector3(2, 0, 2)).z < 2.0, "цель шара: курсор над героем -> вперёд")
	fb.launch(Vector3(0, 3, 0), tgt)
	fb.update(0.1, false, false)
	check(fb.state == "flying" and Fireball.speed_mult(fb) == 1.0, "шар: отпустили ЛКМ -> летит, скорость героя норма")
	fb.update(0.6, false, false)
	check(fb.pos.z < -Fireball.FLY_SPEED * 0.5 and fb.pos.z > -Fireball.FLY_SPEED * 0.7 and fb.pos.y < 3.0 and fb.pos.y > Fireball.LAND_Y, "шар: летит медленно к цели и снижается")
	fb.update(10.0, false, false)
	check(fb.state == "exploded" and fb.pos.is_equal_approx(Vector3(0, Fireball.LAND_Y, -Fireball.MAX_RANGE)), "шар: долетел до границы дальности и взорвался в точке падения")
	check(Fireball.FLY_SPEED >= 12.0, "шар: летит быстро")
	var tr := Trail.new()
	for i in 10:
		tr.update(0.02, Vector3(0, 1, -0.2 * i), true)
	check(tr.parts.size() >= 5 and tr.parts.size() <= Trail.MAX_PARTS, "шлейф: искры остаются вдоль пути")
	tr.update(Trail.LIFE + 0.1, Vector3(0, 1, -2), false)
	check(tr.parts.is_empty(), "шлейф: искры быстро исчезают")
	var fs := Fireball.new(); fs.update(1.0, true, false); fs.update(0.1, false, false)
	fs.launch(Vector3(0, 3, 0), Fireball.aim_target(Vector3.ZERO, Vector3(0, 0, -3)))
	fs.update(5.0, false, false)
	check(fs.state == "exploded" and absf(fs.pos.z + 3.0) < 0.001, "шар: курсор ближе дальности -> падает в курсор")
	var fc := Fireball.new()
	fc.update(1.5, true, false)
	fc.update(0.1, true, true)
	check(fc.state == "fading" and Fireball.speed_mult(fc) == 1.0, "шар: ПКМ при удержании ЛКМ -> отмена")
	var rf := fc.radius()
	fc.update(0.75, true, true)
	check(fc.state == "fading" and fc.radius() < rf, "шар: после отмены медленно уменьшается")
	fc.update(1.0, true, true)
	check(fc.state == "gone", "шар: после отмены пропадает")
	var ft := Fireball.new()
	ft.update(0.1, true, false)
	ft.update(0.1, false, false)
	check(ft.state == "gone", "шар: короткий клик ничего не запускает")
	var fn := Fireball.make_node(root)
	var fz := Fireball.new(); fz.update(1.0, true, false)
	Fireball.apply(fn, fz, 1.0, 0.0)
	check(fn.scale.x > 0.1, "шар: узел получает размер")
	var ex = Explosion.make(Vector3(5, 0, 5), 1)
	check(ex.parts.size() == Explosion.COUNT and not ex.done(), "взрыв: символы созданы")
	var maxd := 0.0
	for k in 40: ex.update(0.025)
	for q in ex.parts: maxd = maxf(maxd, Vector2(q.pos.x - 5, q.pos.z - 5).length())
	check(maxd > 1.5 and ex.parts[0].pos.y >= Explosion.GROUND_Y - 0.001, "взрыв: символы разлетелись в стороны и не уходят под землю")
	check(ex.alpha() < 0.01 and ex.done(), "взрыв: символы гаснут, эффект завершается")
	check(Explosion.scorch_discs(3).size() >= 3 and Explosion.scorch_discs(3) == Explosion.scorch_discs(3), "пятно: несколько дисков, одинаково по seed")
	var en := Explosion.make_node(root, Explosion.make(Vector3.ZERO, 2))
	check(en.get_child_count() == Explosion.COUNT and Explosion.make_scorch(root, Vector3(1, 0, 1), 2).get_child_count() >= 3, "взрыв: узлы символов и пятна собираются")
	var hz := Hero.new(); root.add_child(hz)
	hz.casting = true
	for k in 60: hz.animate(0.05, false, k * 0.05)
	check(hz.cast_amt > 0.95 and absf(hz.staff.position.y - Hero.STAFF_OVERHEAD) < 0.1, "маг: посох над головой при ЛКМ")
	root.free()
	quit(1 if fails else 0)
